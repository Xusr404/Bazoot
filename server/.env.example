# Copy to .env and adjust.
PORT=3001
CLIENT_URL=http://localhost:5005
# Optional: when set and containing a built Vite app, the server serves the SPA.
# Docker sets this to /app/client/dist; locally the default is ../client/dist.
CLIENT_DIST_DIR=../client/dist
MAX_PLAYERS_PER_ROOM=50
# Maximum simultaneously active game rooms before new room creation is rejected.
MAX_ACTIVE_ROOMS=200
# Per-socket live-game guardrails. Exceeding these returns a normal socket error
# instead of allowing one client to overwhelm the game loop.
SOCKET_EVENT_LIMIT_PER_10S=120
PLAYER_ANSWER_LIMIT_PER_10S=20
PLAYER_RECONNECT_LIMIT_PER_MIN=12
MANAGER_CONTROL_LIMIT_PER_10S=30
# Expose process/game counters in /health/ready and /metrics.
HEALTH_INCLUDE_METRICS=false
# Fallback answer time in seconds when a quiz question omits `time`.
QUESTION_TIME_LIMIT=20
# Maximum points for an instant correct answer.
SCORE_MAX=1000
# How long a manager-less started game survives before cleanup.
EMPTY_GAME_TIMEOUT_MS=300000
# SQLite database file for accounts, organizations, quizzes, settings, and sessions.
# In Docker this should live on a mounted volume such as /data/bazoot.db.
DATABASE_FILE=./bazoot.db
# Directory of quiz JSON files (same schema as source config/quizz/*.json).
QUIZZES_DIR=./quizzes
# Manager accounts file (scrypt hashes only, never plaintext). The first account
# is created from the UI on first visit to /manager.
ACCOUNTS_FILE=./accounts.json
# Manager sessions contain hashed tokens and survive server restarts. Their
# lifetime rolls forward while actively used (default: 180 days).
SESSIONS_FILE=./sessions.json
MANAGER_SESSION_TTL_MS=15552000000
# Uploaded question media directory. In Docker this should live on the same
# persistent volume as DATABASE_FILE.
UPLOADS_DIR=./uploads
UPLOAD_MAX_BYTES=52428800
# Allow anyone to self-register a manager account at /manager. Off by default;
# logged-in managers can always add accounts regardless of this setting.
ALLOW_REGISTRATION=false
# Password reset link lifetime (ms), default 1 h. Requires an email on the account.
PASSWORD_RESET_TTL_MS=3600000

# ── Email verification ────────────────────────────────────────────────────────
# auto (default): enforce verification only when SMTP is configured below.
# on:   always enforce (without SMTP, verification links print to the console).
# off:  never enforce.
EMAIL_VERIFICATION=auto
# Mail delivery provider:
# auto:    SMTP when SMTP_HOST is set, otherwise console mode.
# smtp:    require SMTP settings; warns and falls back to console until configured.
# console: always print links/messages to the server console.
MAIL_PROVIDER=auto
# SMTP relay for real delivery. Recommended hosted default: Amazon SES SMTP
# (host like email-smtp.eu-central-1.amazonaws.com, port 587, secure=false).
# Self-hosted relays such as Postal, mailcow, Mailu, or a local Mailpit dev
# server also work because the app only needs standard SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
MAIL_FROM=Bazoot <no-reply@example.com>
# Externally reachable client URL used inside verification links.
PUBLIC_URL=http://localhost:5005
# Verification link lifetime (ms), default 24 h.
VERIFICATION_TTL_MS=86400000

# ── Horizontal Scaling ────────────────────────────────────────────────────────
# Provide a Redis connection string (e.g. redis://localhost:6379) to enable
# horizontal scaling across multiple Node.js processes.
REDIS_URL=
